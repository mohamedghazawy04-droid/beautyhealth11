{
  "entities": {
    "Product": {
      "title": "Product",
      "description": "Store product item",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "nameAr": { "type": "string" },
        "name": { "type": "string" },
        "brand": { "type": "string" },
        "price": { "type": "number" },
        "category": { "type": "string" },
        "image": { "type": "string" },
        "inStock": { "type": "boolean" },
        "stockCount": { "type": "number" }
      },
      "required": ["id", "nameAr", "price", "category"]
    },
    "StoreSettings": {
      "title": "StoreSettings",
      "description": "General store settings",
      "type": "object",
      "properties": {
        "storeName": { "type": "string" },
        "contactWhatsApp": { "type": "string" },
        "contactPhone": { "type": "string" }
      }
    },
    "Order": {
      "title": "Order",
      "description": "Customer order",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "customerName": { "type": "string" },
        "phone": { "type": "string" },
        "total": { "type": "number" }
      },
      "required": ["id", "customerName", "phone", "total"]
    }
  },
  "firestore": {
    "/products/{productId}": {
      "schema": { "$ref": "#/entities/Product" },
      "description": "Products available in the store"
    },
    "/storeSettings/{docId}": {
      "schema": { "$ref": "#/entities/StoreSettings" },
      "description": "Store settings document"
    },
    "/orders/{orderId}": {
      "schema": { "$ref": "#/entities/Order" },
      "description": "Customer orders"
    }
  }
}
